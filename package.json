{
  "name": "narayana-textiles-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/dist/index.mjs",
    "build:single": "SINGLE=1 vite build --outDir dist-single",
    "server": "node --no-warnings server/dist/index.mjs",
    "start": "node --no-warnings server/dist/index.mjs",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.cjs",
    "test:sync": "node e2e/server-sync.cjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.70.0",
    "mongodb": "^6.10.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
