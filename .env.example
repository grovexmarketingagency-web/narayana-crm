# Copy to .env (never commit .env) or set these in Render / Windows environment variables.

# Leave empty on the shop PC to use a SQLite file in DATA_DIR (nothing to install).
# Set it to use MongoDB (Atlas or a local MongoDB). Required on Render.
MONGODB_URI=
MONGODB_DB=narayana
DATA_DIR=server/data

PORT=4545
TZ=Asia/Kolkata

# First start only: creates the shop and the owner's login. Change the PIN in Settings afterwards.
SHOP_NAME=Narayana Textiles
OWNER_NAME=Owner
OWNER_PIN=
# SEED_DEMO=1 loads demo data with public demo PINs (refused when NODE_ENV=production)
SEED_DEMO=

# How long a counter stays logged in (hours)
SESSION_HOURS=16
# Server backups: every N hours (0 = off), keep the newest N
BACKUP_HOURS=24
KEEP_BACKUPS=30
# A second folder that gets a file copy of every backup, outside the database: a pen drive, a second disk,
# or a Google Drive / OneDrive folder that syncs to the cloud. Example on Windows: D:\NarayanaBackups
BACKUP_COPY_DIR=
# PIN tries allowed per address per 15 minutes
LOGIN_TRIES_PER_15MIN=20

# Set to 1 behind Render / a reverse proxy so the real address and https are used
TRUST_PROXY=
# auto = Secure cookie whenever the connection is https
COOKIE_SECURE=auto
NODE_ENV=

# --- Vercel + Supabase (PostgreSQL) version: see VERCEL.md ---
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_CA=            # optional: Supabase's certificate text, turns on full certificate checking
# CRON_SECRET=            # 16+ random characters; Vercel sends it to /api/cron for the daily backup
